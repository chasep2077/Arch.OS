  m_Name: BackupDrive
  m_EditorClassIdentifier: Assembly-CSharp::ArchOS.HardwareSO
  _name: Backup Drive
  _description: A Backup Drive requires 2 hardware slots to install. It has the ability
    to quickly transfer your non-Black ICE programs to them milliseconds before they're
    destroyed. They can then be reused, but remain in the state they were in exactly
    before they were destroyed. Programs stored on a Backup Drive are destroyed as
    soon as the drive is disconnected.
  _cost: 100
  _slotCount: 2
